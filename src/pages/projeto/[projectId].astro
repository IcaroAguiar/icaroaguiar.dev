---
import { publishedCaseStudyIds } from '@/data/projectCatalog';
import { projects, type Project } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projectCategory, projectGallery, projectImage } from '@/utils/projects';

export function getStaticPaths() {
  return projects
    .filter((project) => publishedCaseStudyIds.includes(project.id as (typeof publishedCaseStudyIds)[number]))
    .map((project) => ({ params: { projectId: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props as Props;
const { detailed } = project;
const gallery = projectGallery(project);
const imageDimensions = project.id === 'neo-constrictor'
  ? { width: 2504, height: 1186 }
  : { width: 1600, height: 1000 };
const links = [
  project.liveUrl && ['Ver site', project.liveUrl],
  project.demoUrl && ['Ver demo', project.demoUrl],
  project.githubUrl && [project.privateProject ? 'Repositório' : 'GitHub', project.githubUrl],
  project.backendUrl && ['Backend', project.backendUrl],
].filter(Boolean) as [string, string][];
const publishedProjects = publishedCaseStudyIds
  .map((id) => projects.find((item) => item.id === id))
  .filter((item): item is Project => item !== undefined);
const currentIndex = publishedProjects.findIndex((item) => item.id === project.id);
const nextProject = publishedProjects[(currentIndex + 1) % publishedProjects.length];
---

<BaseLayout title={project.title} description={project.description} image={projectImage(project)}>
  <article class="case-study">
    <header class="case-hero">
      <div class="case-shell case-hero__nav" data-reveal>
        <a href="/projetos"><span aria-hidden="true">←</span> Projetos</a>
        <span>Estudo de caso</span>
      </div>
      <div class="case-shell case-hero__content" data-reveal>
        <p class="case-hero__category">{projectCategory(project)}</p>
        <h1>{project.title}</h1>
        <p class="case-hero__intro">{project.description}</p>
        <div class="case-hero__actions">
          {links.slice(0, 2).map(([label, href]) => (
            <a class="case-action" href={href} target="_blank" rel="noreferrer">{label} <span aria-hidden="true">↗</span></a>
          ))}
        </div>
      </div>
      <dl class="case-shell case-facts" data-reveal>
        <div><dt>Status</dt><dd>{project.status}</dd></div>
        <div><dt>Atuação</dt><dd>{detailed.overview.role}</dd></div>
        <div><dt>Stack principal</dt><dd>{project.tags.slice(0, 4).join(', ')}</dd></div>
      </dl>
    </header>

    <figure class="case-shell case-cover" data-reveal>
      <img src={projectImage(project)} alt={`Interface do projeto ${project.title}`} width={imageDimensions.width} height={imageDimensions.height} loading="eager" fetchpriority="high" />
    </figure>

    {detailed.summary && (
      <section class="case-section case-summary" aria-labelledby="summary-title">
        <div class="case-shell">
          <header class="case-section__heading" data-reveal>
            <h2 id="summary-title">Visão geral</h2>
          </header>
          <div class="case-summary__grid">
            <article data-reveal><span>O produto</span><p>{detailed.summary.what}</p></article>
            <article data-reveal><span>Para quem</span><p>{detailed.summary.audience}</p></article>
            <article data-reveal><span>Valor</span><p>{detailed.summary.value}</p></article>
          </div>
        </div>
      </section>
    )}

    <section class="case-section case-story" aria-labelledby="story-title">
      <div class="case-shell case-story__layout">
        <header class="case-section__heading" data-reveal>
          <h2 id="story-title">Problema e resposta</h2>
          <p>As decisões técnicas partiram do contexto operacional do produto.</p>
        </header>
        <div class="case-story__copy">
          <article data-reveal><h3>O problema</h3><p>{detailed.overview.problem}</p></article>
          <article data-reveal><h3>A solução</h3><p>{detailed.overview.solution}</p></article>
          {detailed.context && (
            <article class="case-story__context" data-reveal><h3>O contexto</h3><p>{detailed.context.problem}</p><p>{detailed.context.motivation}</p></article>
          )}
        </div>
      </div>
    </section>

    <section class="case-section case-architecture" aria-labelledby="architecture-title">
      <div class="case-shell">
        <header class="case-section__heading" data-reveal>
          <h2 id="architecture-title">Arquitetura</h2>
          <p>Responsabilidades explícitas, contratos claros e tecnologia escolhida pelo papel que cumpre.</p>
        </header>
        <div class="architecture-grid">
          {detailed.architecture.map((group) => (
            <article data-reveal>
              <h3>{group.category}</h3>
              <div class="architecture-list">
                {group.technologies.map((technology) => <div><strong>{technology.name}</strong><p>{technology.description}</p></div>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {detailed.decisions && detailed.decisions.length > 0 && (
      <section class="case-section case-decisions" aria-labelledby="decisions-title">
        <div class="case-shell">
          <header class="case-section__heading" data-reveal>
            <h2 id="decisions-title">Decisões de produto</h2>
          </header>
          <div class="decision-grid">
            {detailed.decisions.map((decision) => <article data-reveal><h3>{decision.title}</h3><p>{decision.description}</p></article>)}
          </div>
        </div>
      </section>
    )}

    <section class="case-section case-output" aria-labelledby="output-title">
      <div class="case-shell">
        <header class="case-section__heading" data-reveal>
          <h2 id="output-title">Entrega</h2>
          <p>As capacidades que chegaram à superfície do produto.</p>
        </header>
        <div class="output-grid">
          {detailed.features.map((feature) => <article data-reveal><h3>{feature.title}</h3><p>{feature.description}</p></article>)}
        </div>
      </div>
    </section>

    {gallery.length > 0 && (
      <section class="case-section case-gallery" aria-labelledby="gallery-title">
        <div class="case-shell">
          <header class="case-section__heading" data-reveal>
            <h2 id="gallery-title">Interface em uso</h2>
          </header>
          {gallery.map((image) => (
            <figure data-reveal><img src={image} alt={`Detalhe da interface de ${project.title}`} width={imageDimensions.width} height={imageDimensions.height} loading="lazy" /></figure>
          ))}
        </div>
      </section>
    )}

    <section class="case-next">
      <a class="case-shell" href={`/projeto/${nextProject.id}`} data-reveal>
        <span>Próximo projeto</span>
        <strong>{nextProject.title}</strong>
        <i aria-hidden="true">↗</i>
      </a>
    </section>
  </article>
</BaseLayout>
