---
import profileImage from '@/assets/perfil.jpg';
import { Image } from 'astro:assets';
import { site } from '@/config/site';
import { education } from '@/data/education';
import { experiences } from '@/data/experiences';
import { skills } from '@/data/skills';
import BaseLayout from '@/layouts/BaseLayout.astro';

const principles = [
  ['Contexto antes da solução', 'Produto, domínio e operação orientam a tecnologia.'],
  ['Arquitetura que aparece no uso', 'Contrato, dado, fluxo e interface precisam contar a mesma história.'],
  ['Entrega que sustenta evolução', 'Qualidade, observabilidade e documentação fazem parte do produto.'],
];
---

<BaseLayout
  title="Sobre"
  description="Conheça a trajetória, o método de trabalho e o repertório técnico de Ícaro Aguiar, engenheiro full-stack orientado a produto."
>
  <section class="page-hero section">
    <div class="shell about-hero-grid">
      <div data-reveal>
        <p class="eyebrow">Sobre meu trabalho</p>
        <h1>Engenharia com contexto, autoria e responsabilidade.</h1>
        <p class="page-intro">
          Atuo entre arquitetura, produto e interface para colocar sistemas reais em produção e mantê-los compreensíveis depois da entrega.
        </p>
        <div class="button-row">
          <a class="button" href={site.links.whatsapp} target="_blank" rel="noreferrer">Falar comigo ↗</a>
          <a class="text-link" href={site.links.resume} download>Baixar currículo</a>
        </div>
      </div>
      <figure class="about-portrait" data-reveal>
        <Image src={profileImage} alt="Retrato de Ícaro Aguiar" widths={[480, 720, 960]} sizes="(min-width: 900px) 38vw, 90vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell principle-row" data-reveal>
      {principles.map(([title, description]) => (
        <article><h2>{title}</h2><p>{description}</p></article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="experience-title">
    <div class="shell experience-layout">
      <div class="sticky-heading" data-reveal>
        <h2 id="experience-title">Experiência conectada por produto.</h2>
        <p>Produto próprio, consultoria, sistemas corporativos e educação técnica formam o mesmo repertório.</p>
      </div>
      <div class="experience-list">
        {experiences.map((experience) => (
          <article data-reveal>
            <div><strong>{experience.company}</strong><h3>{experience.role}</h3></div>
            <div><span>{experience.period}</span><ul>{experience.tasks.map((task) => <li>{task}</li>)}</ul></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section skills-section" aria-labelledby="skills-title">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><h2 id="skills-title">Ferramentas seguem a arquitetura.</h2><p>O stack muda conforme o problema. Estes são os recursos que aparecem com mais frequência no trabalho.</p></div>
      </div>
      <div class="skill-groups">
        {Object.entries(skills).map(([category, items]) => (
          <article data-reveal><h3>{category}</h3><ul>{items.map((item) => <li>{item}</li>)}</ul></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight education-section" aria-labelledby="education-title">
    <div class="shell">
      <h2 id="education-title" data-reveal>Formação</h2>
      <div class="education-list">
        {education.map((item) => (
          <article data-reveal><div><strong>{item.course}</strong><p>{item.institution}</p></div><span>{item.status}</span></article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
