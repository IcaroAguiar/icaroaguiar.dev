---
import AboutBento from '@/components/home/AboutBento.astro';
import ContactCard from '@/components/home/ContactCard.astro';
import ExperienceList from '@/components/home/ExperienceList.astro';
import Hero from '@/components/home/Hero.astro';
import OtherProjects from '@/components/home/OtherProjects.astro';
import ProductShowcase from '@/components/home/ProductShowcase.astro';
import SiteCard from '@/components/home/SiteCard.astro';
import SitesIndex from '@/components/home/SitesIndex.astro';
import { featuredSiteIds, showcase, sitesSubtitle, titles } from '@/data/home';
import { experiences } from '@/data/experiences';
import { clientProjects } from '@/data/projectCatalog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { copy } from '@/utils/copy';

const featuredSites = featuredSiteIds.map((id) => clientProjects.find((site) => site.id === id)!);
const otherSites = clientProjects
  .filter((site) => !featuredSiteIds.includes(site.id as (typeof featuredSiteIds)[number]))
  .sort((a, b) => a.title.localeCompare(b.title, 'pt-BR'));
const subtitle = sitesSubtitle(clientProjects.length);
---

<BaseLayout>
  <Hero />

  <section class="c sec" id="projetos">
    <h2 {...copy(titles.projects)}>{titles.projects.pt}</h2>
    <div class="showcases">
      {showcase.map((product, index) => <ProductShowcase product={product} flip={index % 2 === 1} />)}
    </div>
    <OtherProjects />
    <div class="center"><a class="pill" href="/projetos" {...copy(titles.allProjects)}>{titles.allProjects.pt}</a></div>
  </section>

  <section class="c sec" id="sites">
    <h2 {...copy(titles.sites)}>{titles.sites.pt}</h2>
    <p class="sub" {...copy(subtitle)}>{subtitle.pt}</p>
    <div class="g3">{featuredSites.map((site) => <SiteCard site={site} />)}</div>
    <SitesIndex sites={otherSites} />
  </section>

  <section class="c sec" id="experiencia">
    <h2 {...copy(titles.experience)}>{titles.experience.pt}</h2>
    <ExperienceList experiences={experiences} />
  </section>

  <section class="c sec" id="sobre">
    <h2 {...copy(titles.about)}>{titles.about.pt}</h2>
    <AboutBento />
  </section>

  <section class="c sec" id="contato">
    <ContactCard />
  </section>
</BaseLayout>
