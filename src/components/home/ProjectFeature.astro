---
import Icon from '@/components/Icon.astro';
import type { FeaturedProject } from '@/data/home';
import { copy } from '@/utils/copy';

interface Props {
  project: FeaturedProject;
}

const { project } = Astro.props;
---

<a class="card feat" href={project.href}>
  <div class="feat-t">
    <div class="card-h"><Icon name="bulb" /><span {...copy(project.kicker)}>{project.kicker.pt}</span></div>
    <h3>{project.title}</h3>
    <p {...copy(project.description)}>{project.description.pt}</p>
    <dl class="nums">
      {project.numbers.map(({ value, label }) => <div><dt>{value}</dt><dd {...copy(label)}>{label.pt}</dd></div>)}
    </dl>
  </div>
  <div class="well">
    <div class="dg" data-diagram>
      <svg class="w" data-wires aria-hidden="true"></svg>
      {project.diagram.map(({ heading, items }) => (
        <div>
          <h4 {...copy(heading)}>{heading.pt}</h4>
          <ul>
            {items.map(({ label, hot, wire }) => <li class={hot ? 'hot' : undefined} data-w={wire} {...copy(label)}>{label.pt}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</a>

<script>
  const diagram = document.querySelector<HTMLElement>('[data-diagram]');
  const wires = diagram?.querySelector<SVGElement>('[data-wires]');

  // Liga os itens marcados com data-w por curvas tracejadas; no celular o SVG fica oculto.
  function drawWires() {
    if (!diagram || !wires || getComputedStyle(wires).display === 'none') return;
    const box = diagram.getBoundingClientRect();
    const points = (['a', 'b', 'c', 'd'] as const).map((key) => diagram.querySelector(`[data-w="${key}"]`)?.getBoundingClientRect());
    let paths = '';
    for (let i = 0; i < points.length - 1; i++) {
      const from = points[i];
      const to = points[i + 1];
      if (!from || !to) continue;
      const x1 = from.right - box.left;
      const y1 = from.top + from.height / 2 - box.top;
      const x2 = to.left - box.left;
      const y2 = to.top + to.height / 2 - box.top;
      const mid = (x1 + x2) / 2;
      paths += `<path d="M${x1} ${y1} C${mid} ${y1} ${mid} ${y2} ${x2} ${y2}" fill="none" stroke="#a1a1a1" stroke-width="1" stroke-dasharray="3 3"/>`;
    }
    wires.innerHTML = paths;
  }

  drawWires();
  addEventListener('resize', drawWires);
  addEventListener('portfolio:language-change', drawWires);
  document.fonts?.ready.then(drawWires);
</script>
