---
import type { Project } from '@/data/projects';
import { projectCategory, projectImage } from '@/utils/projects';

interface Props {
  project: Project;
  featured?: boolean;
  eager?: boolean;
}

const { project, featured = false, eager = false } = Astro.props;
const category = projectCategory(project);
---

<article
  class:list={['project-entry', { 'project-entry--featured': featured }]}
  data-project-card
  data-category={category}
>
  <a class="project-entry__media" href={`/projeto/${project.id}`} aria-label={`Abrir projeto ${project.title}`}>
    <img
      src={projectImage(project)}
      alt={`Interface do projeto ${project.title}`}
      width="1600"
      height="1000"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <span class="project-entry__open" aria-hidden="true">Ver projeto ↗</span>
  </a>

  <div class="project-entry__body">
    <div class="project-entry__meta">
      <span>{category}</span>
      <span>{project.status}</span>
    </div>
    <h3><a href={`/projeto/${project.id}`}>{project.title}</a></h3>
    <p>{project.description}</p>
    <ul class="tag-line" aria-label={`Tecnologias de ${project.title}`}>
      {project.tags.slice(0, featured ? 6 : 4).map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>
