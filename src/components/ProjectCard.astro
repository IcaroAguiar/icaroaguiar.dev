---
import type { Project } from '@/data/projects';
import { projectCategory, projectImage } from '@/utils/projects';

interface Props {
  project: Project;
  featured?: boolean;
  eager?: boolean;
}

const { project, featured = false, eager = false } = Astro.props;
---

<a
  class:list={['project-card', { 'project-card-featured': featured }]}
  href={`/projeto/${project.id}`}
  data-project-card
  data-category={projectCategory(project)}
>
  <article>
    <div class="project-media">
      <img
        src={projectImage(project)}
        alt={`Preview do projeto ${project.title}`}
        width="1600"
        height="1000"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
    <div class="project-card-body">
      <div class="project-meta">
        <span>{projectCategory(project)}</span>
        <span>{project.status}</span>
        {project.privateProject && <span>restrito</span>}
      </div>
      <h3>{project.title}</h3>
      <p>{project.description}</p>
      <ul class="tag-list" aria-label={`Tecnologias de ${project.title}`}>
        {project.tags.slice(0, featured ? 6 : 4).map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
    <span class="project-arrow" aria-hidden="true">↗</span>
  </article>
</a>
