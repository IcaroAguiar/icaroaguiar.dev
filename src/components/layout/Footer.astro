---
import { site } from '@/config/site';
---

<footer id="contato" class="site-footer">
  <section class="footer-quote" aria-labelledby="footer-quote-title">
    <p class="footer-quote__eyebrow" data-copy-pt="Obrigado pela visita" data-copy-en="Thank you for visiting">Obrigado pela visita</p>
    <blockquote id="footer-quote-title">
      <p><span aria-hidden="true">“</span><span data-copy-pt="Nada grandioso nasce de repente." data-copy-en="Nothing great is produced suddenly.">Nada grandioso nasce de repente.</span><span aria-hidden="true">”</span></p>
      <footer><span aria-hidden="true">-</span><cite>Epicteto</cite></footer>
    </blockquote>
  </section>
  <div class="footer-signature">
    <div class="footer-signature__identity">
      <span class="footer-signature__eyebrow" data-copy-pt="Contato" data-copy-en="Contact">Contato</span>
      <p>Ícaro Aguiar</p>
      <span class="footer-signature__role" data-copy-pt="Engenheiro de software" data-copy-en="Software engineer">Engenheiro de software</span>
    </div>
    <nav class="footer-links" aria-label="Contato e links externos">
      <a class="footer-link footer-link--wide" href={`mailto:${site.email}`}>
        <span class="footer-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v11h-17z"></path><path d="m4 7 8 6 8-6"></path></svg></span>
        <span class="footer-link__copy"><strong>Email</strong><small>{site.email}</small></span><i>↗</i>
      </a>
      <a class="footer-link" href={site.links.github} target="_blank" rel="noreferrer">
        <span class="footer-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7.4A5.8 5.8 0 0 0 19.3 3 5.4 5.4 0 0 0 19.1 0S17.9-.4 15 1.5a13.4 13.4 0 0 0-6 0C6.1-.4 4.9 0 4.9 0a5.4 5.4 0 0 0-.2 3A5.8 5.8 0 0 0 3.2 7.1c0 5.8 3.5 7 6.8 7.4A4.8 4.8 0 0 0 9 18v4"></path><path d="M9 19c-3 .9-3-1.5-4.2-2"></path></svg></span>
        <span class="footer-link__copy"><strong>GitHub</strong><small>@IcaroAguiar</small></span><i>↗</i>
      </a>
      <a class="footer-link" href={site.links.linkedin} target="_blank" rel="noreferrer">
        <span class="footer-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 9v11"></path><path d="M4 4.5v.5"></path><path d="M9 20v-6.2C9 11.2 10.5 9 13.5 9S18 11.2 18 13.8V20"></path></svg></span>
        <span class="footer-link__copy"><strong>LinkedIn</strong><small data-copy-pt="Perfil profissional" data-copy-en="Professional profile">Perfil profissional</small></span><i>↗</i>
      </a>
      <a class="footer-link footer-link--wide" href={site.links.resume} download>
        <span class="footer-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 2.5h8l4 4V21H6z"></path><path d="M14 2.5V7h4"></path><path d="M9 12h6M9 16h6"></path></svg></span>
        <span class="footer-link__copy"><strong data-copy-pt="Baixar currículo" data-copy-en="Download résumé">Baixar currículo</strong><small data-copy-pt="PDF · Português" data-copy-en="PDF · Portuguese">PDF · Português</small></span><i>↓</i>
      </a>
    </nav>
  </div>
  <div class="footer-base">
    <span>© {new Date().getFullYear()} Ícaro Aguiar</span>
    <span>Salvador, Bahia</span>
    <span data-copy-pt="Brasil" data-copy-en="Brazil">Brasil</span>
  </div>
</footer>
