const filled = new Set(['github', 'linkedin']);

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className = 'i' } = Astro.props;
const solid = filled.has(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? undefined : 'currentColor'}
  stroke-width={solid ? undefined : 1.8}
  stroke-linecap={solid ? undefined : 'round'}
  stroke-linejoin={solid ? undefined : 'round'}
  set:html={icons[name]}
/>
